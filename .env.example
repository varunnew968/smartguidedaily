# Public site URL. Set this to your production URL on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=SmartGuideDaily

# Supabase project settings. Keep SERVICE_ROLE_KEY secret and server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login (use a long, unique password)
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: add your AdSense publisher ID after approval, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
